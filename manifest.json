{
  "manifest_version": 3,
  "name": "ECO Admin Block Injector",
  "version": "1.0",
  "description": "Split a full HTML file into page_content blocks in ECO Admin",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://ecoadmin.wbresearch.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
